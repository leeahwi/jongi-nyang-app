<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>찾은 내용 %lld개</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld result</string>
			<key>other</key>
			<string>%lld results</string>
		</dict>
	</dict>
	<key>최장 %lld일</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Longest: %lld day</string>
			<key>other</key>
			<string>Longest: %lld days</string>
		</dict>
	</dict>
	<key>오늘 할 일 %lld개 모두 마침</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Today’s to-do is done</string>
			<key>other</key>
			<string>All %lld of today’s to-dos are done</string>
		</dict>
	</dict>
	<key>%lld시간마다</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Every hour</string>
			<key>other</key>
			<string>Every %lld hours</string>
		</dict>
	</dict>
	<key>날짜가 기록되기 전에 완료한 %lld개는 달력에 표시하지 않아요.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld to-do finished before dates were kept isn’t shown on the calendar.</string>
			<key>other</key>
			<string>%lld to-dos finished before dates were kept aren’t shown on the calendar.</string>
		</dict>
	</dict>
	<key>오늘 고친 메모 %lld장</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld note changed today</string>
			<key>other</key>
			<string>%lld notes changed today</string>
		</dict>
	</dict>
</dict>
</plist>
