{
  "about": "#385: cloud conflict copies in the storage folder, and joining todos.json · events.json · alarms.json by item when another device wrote them. Read by mac/Tests/PaperCoreTests/SyncConflictTests.swift; windows/test/syncConflict.test.ts reads the same file. Made-up data only.",
  "copies": [
    { "name": "todos 2.json", "copyOf": "todos.json", "why": "iCloud Drive" },
    { "name": "events 3.json", "copyOf": "events.json", "why": "iCloud Drive" },
    { "name": "memo-folders 2.json", "copyOf": "memo-folders.json", "why": "iCloud Drive, a name with a hyphen" },
    { "name": "todos (1).json", "copyOf": "todos.json", "why": "Google Drive" },
    { "name": "alarms (12).json", "copyOf": "alarms.json", "why": "Google Drive" },
