    { "name": "TODOS 2.JSON", "copyOf": "todos.json", "why": "a case-insensitive folder" },
    { "name": "todos.json", "copyOf": null, "why": "the file itself" },
    { "name": "memo-folders.json", "copyOf": null, "why": "another data file, not a copy of memos" },
    { "name": "todo-spaces.json", "copyOf": null, "why": "another data file" },
    { "name": "todos.unreadable-1793000000.json", "copyOf": null, "why": "this app's own copy of an unreadable file" },
    { "name": "memo-folders.json.unreadable-20261111-090000", "copyOf": null, "why": "this app's own copy, not .json" },
    { "name": "todos 2.json.icloud", "copyOf": null, "why": "an iCloud placeholder (not downloaded)" },
    { "name": "todos 2026.json", "copyOf": null, "why": "a number too long for a copy" },
    { "name": "todos (copy).json", "copyOf": null, "why": "not a number, not a conflicted copy" },
    { "name": "todos-.json", "copyOf": null, "why": "no device name" },
    { "name": "todos-내 PC.json", "copyOf": null, "why": "OneDrive names are letters, digits, - and _" },
