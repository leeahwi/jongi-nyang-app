    { "name": "todos 2.txt", "copyOf": null, "why": "not .json" }
  ],
  "merge": [
    {
      "name": "M1 nothing changed here: theirs as it is",
      "base": [{ "id": "a", "title": "장보기" }],
      "here": [{ "id": "a", "title": "장보기" }],
      "theirs": [{ "id": "a", "title": "장보기, 우유" }, { "id": "b", "title": "빨래" }],
      "expected": [{ "id": "a", "title": "장보기, 우유" }, { "id": "b", "title": "빨래" }]
    },
    {
      "name": "M2 nothing changed there: this device's as it is",
      "base": [{ "id": "a", "title": "장보기" }],
      "here": [{ "id": "a", "title": "장보기", "isCompleted": true }, { "id": "c", "title": "공부" }],
      "theirs": [{ "id": "a", "title": "장보기" }],
      "expected": [{ "id": "a", "title": "장보기", "isCompleted": true }, { "id": "c", "title": "공부" }]
    },
    {
      "name": "M3 one item, different fields changed on each side: both changes",
      "base": [{ "id": "a", "title": "장보기", "isCompleted": false }],
      "here": [{ "id": "a", "title": "장보기", "isCompleted": true, "completedAt": "2026-11-11T09:00:00Z" }],
      "theirs": [{ "id": "a", "title": "장보기, 우유", "isCompleted": false }],
      "expected": [{ "id": "a", "title": "장보기, 우유", "isCompleted": true, "completedAt": "2026-11-11T09:00:00Z" }]
    },
    {
      "name": "M4 the same field changed on both sides: this device's",
      "base": [{ "id": "a", "title": "장보기" }],
      "here": [{ "id": "a", "title": "장보기 (마트)" }],
      "theirs": [{ "id": "a", "title": "장보기 (시장)" }],
      "expected": [{ "id": "a", "title": "장보기 (마트)" }]
    },
    {
      "name": "M5 deleted there, untouched here: gone",
      "base": [{ "id": "a", "title": "장보기" }, { "id": "b", "title": "빨래" }],
      "here": [{ "id": "a", "title": "장보기" }, { "id": "b", "title": "빨래" }],
      "theirs": [{ "id": "b", "title": "빨래" }],
      "expected": [{ "id": "b", "title": "빨래" }]
    },
    {
      "name": "M6 deleted there, changed here: kept as changed here",
      "base": [{ "id": "a", "title": "장보기" }, { "id": "b", "title": "빨래" }],
      "here": [{ "id": "a", "title": "장보기, 우유" }, { "id": "b", "title": "빨래" }],
      "theirs": [{ "id": "b", "title": "빨래" }],
      "expected": [{ "id": "a", "title": "장보기, 우유" }, { "id": "b", "title": "빨래" }]
    },
    {
      "name": "M7 deleted here, untouched there: gone",
      "base": [{ "id": "a", "title": "장보기" }, { "id": "b", "title": "빨래" }],
      "here": [{ "id": "b", "title": "빨래" }],
      "theirs": [{ "id": "a", "title": "장보기" }, { "id": "b", "title": "빨래" }],
      "expected": [{ "id": "b", "title": "빨래" }]
    },
    {
      "name": "M8 deleted here, changed there: kept as changed there",
      "base": [{ "id": "a", "title": "장보기" }],
      "here": [],
      "theirs": [{ "id": "a", "title": "장보기, 달걀" }],
      "expected": [{ "id": "a", "title": "장보기, 달걀" }]
    },
    {
      "name": "M9 new on both sides: both, theirs first, this device's after the item it followed",
      "base": [{ "id": "a", "title": "장보기" }],
      "here": [{ "id": "a", "title": "장보기" }, { "id": "m", "title": "Mac에서 더함" }],
      "theirs": [{ "id": "a", "title": "장보기" }, { "id": "w", "title": "Windows에서 더함" }],
      "expected": [{ "id": "a", "title": "장보기" }, { "id": "m", "title": "Mac에서 더함" }, { "id": "w", "title": "Windows에서 더함" }]
    },
    {
      "name": "M10 an item new here at the top stays at the top",
      "base": [{ "id": "a", "title": "장보기" }],
      "here": [{ "id": "m", "title": "회사 보고서" }, { "id": "a", "title": "장보기" }],
      "theirs": [{ "id": "a", "title": "장보기" }, { "id": "b", "title": "빨래" }],
      "expected": [{ "id": "m", "title": "회사 보고서" }, { "id": "a", "title": "장보기" }, { "id": "b", "title": "빨래" }]
    },
    {
      "name": "M11 a field removed (null or missing) on one side counts as a change",
      "base": [{ "id": "a", "title": "장보기", "dueDate": "2026-11-12" }],
      "here": [{ "id": "a", "title": "장보기" }],
      "theirs": [{ "id": "a", "title": "장보기, 우유", "dueDate": "2026-11-12" }],
      "expected": [{ "id": "a", "title": "장보기, 우유" }]
    },
    {
      "name": "M12 no base (the file was never read here): this device's fields win where they differ",
      "base": [],
      "here": [{ "id": "a", "title": "장보기", "isCompleted": true }],
      "theirs": [{ "id": "a", "title": "장보기", "isCompleted": false }, { "id": "b", "title": "빨래" }],
      "expected": [{ "id": "a", "title": "장보기", "isCompleted": true }, { "id": "b", "title": "빨래" }]
    },
    {
      "name": "M13 nested values compare whole, keys in any order (an event's repeat, an alarm's days)",
      "base": [{ "id": "e", "title": "회의", "repeat": { "kind": "weekly", "every": 1 }, "skip": [] }],
      "here": [{ "id": "e", "title": "회의", "repeat": { "every": 1, "kind": "weekly" }, "skip": ["2026-11-18"] }],
      "theirs": [{ "id": "e", "title": "회의 (3층)", "repeat": { "kind": "weekly", "every": 1 }, "skip": [] }],
      "expected": [{ "id": "e", "title": "회의 (3층)", "repeat": { "kind": "weekly", "every": 1 }, "skip": ["2026-11-18"] }]
    }
  ]
